<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <io.github.thibaultbee.streampack.ui.views.PreviewView
        android:id="@+id/preview"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ToggleButton
        android:id="@+id/liveButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="32dp"
        android:background="@drawable/ic_live_button"
        android:textColor="@color/white"
        android:textOff=""
        android:textOn=""
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- 配信URL/パラメータを端末上で編集 -->
    <EditText
        android:id="@+id/serverUrl"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="#CC000000"
        android:textColor="@android:color/white"
        android:textColorHint="#88FFFFFF"
        android:textSize="11sp"
        android:padding="8dp"
        android:hint="srt://[ipv6]:5000?streamid=publish:car"
        android:inputType="textNoSuggestions|textMultiLine"
        android:maxLines="3"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 設定: ビットレート(kbps) / 解像度 / fps -->
    <LinearLayout
        android:id="@+id/settingsRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/serverUrl"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <EditText
            android:id="@+id/bitrateInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="#CC000000"
            android:textColor="@android:color/white"
            android:textColorHint="#88FFFFFF"
            android:textSize="11sp"
            android:padding="6dp"
            android:hint="kbps"
            android:inputType="number" />

        <EditText
            android:id="@+id/resInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:layout_marginStart="4dp"
            android:background="#CC000000"
            android:textColor="@android:color/white"
            android:textColorHint="#88FFFFFF"
            android:textSize="11sp"
            android:padding="6dp"
            android:hint="1280x720"
            android:inputType="text" />

        <EditText
            android:id="@+id/fpsInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.8"
            android:layout_marginStart="4dp"
            android:background="#CC000000"
            android:textColor="@android:color/white"
            android:textColorHint="#88FFFFFF"
            android:textSize="11sp"
            android:padding="6dp"
            android:hint="fps"
            android:inputType="number" />
    </LinearLayout>

    <!-- 操作: 設定適用 / カメラ切替 -->
    <LinearLayout
        android:id="@+id/buttonRow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="4dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/settingsRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/applyButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textSize="12sp"
            android:text="設定適用" />

        <Button
            android:id="@+id/switchCamButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:textSize="12sp"
            android:text="カメラ切替" />
    </LinearLayout>

    <!-- 接続状態/エラー/統計を常時表示 -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="8dp"
        android:background="#CC000000"
        android:textColor="@android:color/white"
        android:textSize="12sp"
        android:padding="8dp"
        android:text="待機中"
        app:layout_constraintTop_toBottomOf="@id/buttonRow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
